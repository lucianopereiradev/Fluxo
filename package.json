{
  "name": "fluxo",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first personal finance organizer with optional end-to-end encrypted sync.",
  "type": "module",
  "license": "MIT",
  "author": "Luciano Pereira",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "echarts": "^6.1.0",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.66.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-router": "^7.18.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.7",
    "gifenc": "^1.0.3",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.156.1"
  }
}
